From 5134662241ae6033e2ab77f8e3d0159d7586c0dc Mon Sep 17 00:00:00 2001
From: llm-pt-ibm <llm-pt-ibm@ufcg.edu.br>
Date: Thu, 6 Aug 2026 15:01:58 +0000
Subject: [PATCH 2/4] cmake: patch onnxruntime-extensions for system zlib on
 ppc64le

extensions fetches upstream libpng on PowerPC (dlib bundles an ARM-only
libpng), which links the system zlib -- but image_encoder.hpp still pins
ZLIB_VERNUM to the vendored 1.2.11. Apply the fix via FetchContent
PATCH_COMMAND so it survives clean rebuilds.
---
 .../external/onnxruntime_external_deps.cmake  |  9 ++++++
 .../0001-ppc64le-allow-system-zlib.patch      | 32 +++++++++++++++++++
 2 files changed, 41 insertions(+)
 create mode 100644 cmake/patches/onnxruntime_extensions/0001-ppc64le-allow-system-zlib.patch

diff --git a/cmake/external/onnxruntime_external_deps.cmake b/cmake/external/onnxruntime_external_deps.cmake
index e7e5826..7ce813e 100644
--- a/cmake/external/onnxruntime_external_deps.cmake
+++ b/cmake/external/onnxruntime_external_deps.cmake
@@ -80,10 +80,19 @@ if(USE_DML)
 endif()
 
 
+set(_ortx_patch_command "")
+if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(powerpc|ppc)")
+  # See the patch header: onnxruntime-extensions' PowerPC branch uses the system
+  # zlib, but image_encoder.hpp still pins the vendored zlib version.
+  set(_ortx_patch_command git apply --ignore-space-change --ignore-whitespace
+      "${PROJECT_SOURCE_DIR}/cmake/patches/onnxruntime_extensions/0001-ppc64le-allow-system-zlib.patch")
+endif()
+
 FetchContent_Declare(
   onnxruntime_extensions
   GIT_REPOSITORY ${DEP_URL_onnxruntime_extensions}
   GIT_TAG ${DEP_SHA1_onnxruntime_extensions}
+  PATCH_COMMAND ${_ortx_patch_command}
 )
 set(OCOS_BUILD_PRESET ort_genai)
 onnxruntime_fetchcontent_makeavailable(onnxruntime_extensions)
diff --git a/cmake/patches/onnxruntime_extensions/0001-ppc64le-allow-system-zlib.patch b/cmake/patches/onnxruntime_extensions/0001-ppc64le-allow-system-zlib.patch
new file mode 100644
index 0000000..7b45db2
--- /dev/null
+++ b/cmake/patches/onnxruntime_extensions/0001-ppc64le-allow-system-zlib.patch
@@ -0,0 +1,32 @@
+From: llm-pt-ibm <llm-pt-ibm@ufcg.edu.br>
+Subject: [PATCH] vision: don't pin the vendored zlib version on PowerPC
+
+cmake/ext_imgcodecs.cmake already has a PowerPC branch: because dlib's
+bundled libpng only ships ARM/NEON optimizations, on ppc64/ppc64le it
+fetches upstream libpng instead, and that libpng resolves zlib with
+find_package(ZLIB) -- i.e. the *system* zlib, not dlib's vendored copy.
+
+image_encoder.hpp was never updated for that branch. It still hard-asserts
+ZLIB_VERNUM == 0x12b0 (the vendored zlib 1.2.11), so on PowerPC the build
+fails with:
+
+    image_encoder.hpp:10:2: error: #error "stopped"
+    note: Invalid zlib version: 0x1320
+
+Skip the pin on PowerPC, where using the system zlib is the intended design.
+
+--- a/operators/vision/image_encoder.hpp
++++ b/operators/vision/image_encoder.hpp
+@@ -2,7 +2,11 @@
+ // Licensed under the MIT License.
+
+ #include "zlib.h"
+-#if ZLIB_VERNUM != 0x12b0
++// On PowerPC, ext_imgcodecs.cmake builds upstream libpng against the system
++// zlib rather than dlib's vendored 1.2.11, so this version pin does not apply.
++#if defined(__powerpc__) || defined(__powerpc64__)
++// system zlib: version not pinned
++#elif ZLIB_VERNUM != 0x12b0
+ // the following is a trick to show the invalid version number for the diagnosis.
+ #define STR_VERSION(x) STR_NUM(x)
+ #define STR_NUM(x) #x
