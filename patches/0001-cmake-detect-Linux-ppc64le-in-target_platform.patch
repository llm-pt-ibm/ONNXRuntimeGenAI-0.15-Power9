From 04931ba16696a28a4f3abd4a317a746bca2f26f7 Mon Sep 17 00:00:00 2001
From: llm-pt-ibm <llm-pt-ibm@ufcg.edu.br>
Date: Thu, 6 Aug 2026 14:57:56 +0000
Subject: [PATCH 1/4] cmake: detect Linux ppc64le in target_platform

CMAKE_SYSTEM_PROCESSOR is "powerpc" only on AIX; Linux on POWER reports
"ppc64le" (little-endian) or "ppc64". The existing branch therefore never
matched on Linux and the build died with
"Unsupported architecture. CMAKE_SYSTEM_PROCESSOR: ppc64le".
---
 cmake/target_platform.cmake | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/cmake/target_platform.cmake b/cmake/target_platform.cmake
index 222e420..bb251be 100644
--- a/cmake/target_platform.cmake
+++ b/cmake/target_platform.cmake
@@ -57,7 +57,8 @@ else()
     set(genai_target_platform "arm64")
   elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64)$")
     set(genai_target_platform "x64")
-  elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "powerpc")
+  elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(powerpc|ppc)")
+    # AIX reports "powerpc"; Linux on POWER reports "ppc64le" (and "ppc64" on BE).
     set(genai_target_platform "powerpc")
   else()
     message(FATAL_ERROR "Unsupported architecture. CMAKE_SYSTEM_PROCESSOR: ${CMAKE_SYSTEM_PROCESSOR}")
